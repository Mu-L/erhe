{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "ERHE_physics.schema.json",
    "title": "ERHE_physics glTF node extension",
    "type": "object",
    "properties": {
        "motion_mode": {
            "type": "string",
            "enum": ["static", "kinematic_non_physical", "kinematic_physical", "dynamic"]
        },
        "properties": {"type": "object", "additionalProperties": {"type": "string"}, "description": "Local values of the body attachment's registered properties (name -> text)"}
    },
    "required": ["motion_mode"]
}
