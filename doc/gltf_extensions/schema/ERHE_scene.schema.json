{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "ERHE_scene.schema.json",
    "title": "ERHE_scene glTF scene extension",
    "type": "object",
    "properties": {
        "ambient_light": {
            "type": "array",
            "items": {"type": "number"},
            "minItems": 4,
            "maxItems": 4
        },
        "enable_physics": {"type": "boolean"},
        "settings": {
            "type": "object",
            "description": "Scene_settings object (erhe_codegen schema, src/editor/scene/definitions/scene_settings.py)"
        },
        "styles": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "name": {"type": "string"},
                    "properties": {"type": "object", "additionalProperties": {"type": "string"}}
                },
                "required": ["name"]
            }
        },
        "physics_material_names": {"type": "array", "items": {"type": "string"}, "description": "Names of the KHR_physics_rigid_bodies physicsMaterials entries, by index"},
        "collision_filter_names": {"type": "array", "items": {"type": "string"}, "description": "Names of the KHR_physics_rigid_bodies collisionFilters entries, by index"},
        "library_folders": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "path": {"type": "string", "description": "Slash-separated folder path from the library root, starting with the category folder name"},
                    "properties": {"type": "object", "additionalProperties": {"type": "string"}},
                    "items": {"type": "array", "items": {"type": "string"}},
                    "style": {"type": "string", "description": "Name of the style item the folder uses"}
                },
                "required": ["path"]
            }
        }
    },
    "required": ["ambient_light", "enable_physics"]
}
